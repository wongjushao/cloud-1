DOMAIN_NAME={{ ansible_host }}

MYSQL_ROOT_PASSWORD={{ lookup('env', 'MYSQL_ROOT_PASSWORD') }}
MYSQL_DATABASE={{ lookup('env', 'MYSQL_DATABASE') | default('wordpress_db', true) }}
MYSQL_USER={{ lookup('env', 'MYSQL_USER') | default('wp_user', true) }}
MYSQL_PASSWORD={{ lookup('env', 'MYSQL_PASSWORD') }}

WP_TITLE={{ lookup('env', 'WP_TITLE') | default('Cloud-1', true) }}
WP_ADMIN_USER={{ lookup('env', 'WP_ADMIN_USER') | default('admin', true) }}
WP_ADMIN_PASSWORD={{ lookup('env', 'WP_ADMIN_PASSWORD') }}
WP_ADMIN_EMAIL={{ lookup('env', 'WP_ADMIN_EMAIL') }}
WP_USER={{ lookup('env', 'WP_USER') | default('wp_editor', true) }}
WP_USER_PASSWORD={{ lookup('env', 'WP_USER_PASSWORD') }}
WP_USER_EMAIL={{ lookup('env', 'WP_USER_EMAIL') }}

DB_HOST={{ lookup('env', 'DB_HOST') | default('mariadb:3306', true) }}

DATA_PATH={{ data_path }}
SSL_PATH={{ ssl_path }}
